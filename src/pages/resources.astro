---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ResourceList from "../components/ResourceList.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { resources, site } from "../data/site.js";
---

<BaseLayout title={`Resources | ${site.name}`} description="Download Practical Psychology Consultancy resources on leadership, mental health, and coaching.">
  <Hero
    variant="page"
    eyebrow="Resources"
    title="Evidence-informed guides to download"
    subtitle="Practical PDFs covering leadership, work stressors, coaching outcomes, and work effectiveness."
  />

  <section class="section">
    <SectionHeader
      eyebrow="PDF library"
      title="Resources by topic"
      lead="Downloadable guides for immediate reference and team discussion."
    />
    <ResourceList resources={resources} />
  </section>
</BaseLayout>
