---
import { navItems, site } from "../data/site.js";

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <a class="brand" href="/" aria-label={`${site.name} home`}>
    <img src="/assets/images/logo_transparent_background.png" alt="" width="96" height="96" />
    <span>{site.name}</span>
  </a>

  <nav class="primary-nav" aria-label="Primary navigation">
    {navItems.map((item) => (
      <a
        href={item.href}
        aria-current={currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href)) ? "page" : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>

  <a class="header-contact" href={site.phoneHref}>{site.phoneDisplay}</a>
</header>
