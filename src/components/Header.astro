---
import { navItems, site } from "../data/site.js";

const currentPath = Astro.url.pathname;
---

<header class="site-header" data-site-header>
  <div class="header-inner">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <img src="/assets/images/logo-96.webp" alt="" width="96" height="53" />
      <span>{site.name}</span>
    </a>

    <nav class="primary-nav" id="primary-nav" aria-label="Primary navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href)) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <a class="header-contact" href={site.phoneHref}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" />
      </svg>
      <span>{site.phoneDisplay}</span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label="Menu" data-nav-toggle>
      <span class="nav-toggle-bars" aria-hidden="true"></span>
      <span class="nav-toggle-label">Menu</span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector("[data-site-header]");
  const toggle = document.querySelector("[data-nav-toggle]");

  if (header instanceof HTMLElement && toggle instanceof HTMLButtonElement) {
    const setOpen = (open: boolean) => {
      header.toggleAttribute("data-open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => setOpen(!header.hasAttribute("data-open")));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && header.hasAttribute("data-open")) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
