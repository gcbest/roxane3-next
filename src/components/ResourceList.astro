---
const { resources } = Astro.props;
---

<div class="resource-list">
  {resources.map((group) => (
    <section class="resource-group">
      <h2>{group.category}</h2>
      <div>
        {group.items.map((item) => (
          <a class="download-link" href={item.url} download>
            <span>{item.title}</span>
            <strong>PDF</strong>
          </a>
        ))}
      </div>
    </section>
  ))}
</div>
